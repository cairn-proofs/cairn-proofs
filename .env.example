# Cairn Proofs — deployment environment template
#
# Copy this file to `.env` (gitignored) and fill in the real values for your
# deployment. `.env` is loaded once by mise (see the [env] block in mise.toml)
# and exported to PATH-tool sessions, so BOTH the TypeScript CDK app
# (cdk/bin/artifact-store.ts) and the bash deploy/reset scripts
# (cdk/scripts/deploy.sh, cdk/scripts/reset-alpha-data.sh) read these vars
# from one canonical source. Never commit `.env`.
#
# These are operator ASSERTIONS of the deploy target — not values that follow
# whoever's AWS credentials happen to be active. The reset-alpha-data.sh
# destructive-op guard depends on CAIRN_ALPHA_ACCOUNT being an explicit
# expected account, so set it deliberately.

# The 12-digit AWS account ID the alpha stack deploys into.
# Example below uses the canonical AWS documentation account; replace it with
# your real account ID in `.env`.
CAIRN_ALPHA_ACCOUNT=123456789012

# The AWS region the alpha stack is pinned to. Must be a region registered in
# cdk/lib/region-codes.ts (the region → airport-code registry); deploys fail
# fast on an unregistered region. Region pinning is for the deployment's
# lifetime — a deployment is confined to one region.
CAIRN_ALPHA_REGION=us-east-2

# ─────────────────────────────────────────────────────────────────────────────
# cairn CLI (push / pull / verify / query / alias / sign / tui)
# ─────────────────────────────────────────────────────────────────────────────
# Read by the `cairn` CLI, NOT the CDK/deploy path. ALL of these are OPTIONAL —
# every one has a non-env fallback (a command-line flag, an SSM discovery
# parameter the deployed stack publishes, or a persisted config file) — so the
# CLI runs with none of them set. They are commented out below; uncomment only
# the ones you want to default so you need not repeat the flags on every call.

# AWS region the CLI targets. Resolved via boto3 (AWS_REGION, then
# AWS_DEFAULT_REGION, then your AWS profile's default region), so set this only
# if your active AWS profile has no default region. Match the deployment region
# (CAIRN_ALPHA_REGION above).
# AWS_REGION=us-east-2

# Deployment appName override. The CLI normally DISCOVERS appName from the SSM
# parameter `/cairnproofs/{regionCode}-{stage}/app-name` the stack publishes (and
# from it the auto-named DynamoDB table names at `/{appName}/{stage}/tables/*`),
# so leave this unset for the normal path. Set it (or pass `--app-name`) only to
# target a specific deployment without the SSM round-trip. Example: cairnproofs4af.
# CAIRN_APP_NAME=cairnproofs4af

# Default `cairn push` identity coordinates — the opaque
# {org-id}/{tenant-id}/{project-id} that populate the producer claim and address
# the ECR repository path ([INGEST-032]). Resolution precedence: explicit
# --org-id/--tenant-id/--project-id (or --target {org}/{tenant}/{project}) >
# these env vars > a persisted .cairn.toml / `cairn config set-target`. Opaque,
# stable, allocate-once ids — NOT display names.
# CAIRN_ORG_ID=org-example
# CAIRN_TENANT_ID=tnt-example
# CAIRN_PROJECT_ID=prj-example

# Where `cairn config set-target` persists the per-user default target
# (cairn/config.toml) and where the Notation trust policy is installed. Standard
# XDG variable; defaults to ~/.config when unset. Usually leave unset.
# XDG_CONFIG_HOME=
