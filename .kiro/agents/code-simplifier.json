{
  "$schema": "https://json.schemastore.org/kiro-agent.json",
  "name": "code-simplifier",
  "description": "Use when code needs to be cleaned up, made more readable, or reduced in complexity \u2014 without changing behavior. Triggers on \"simplify this\", \"this is too complex\", \"clean this up\", \"refactor for clarity\", \"this is hard to read\", or \"reduce nesting/complexity\".",
  "prompt": "file://../agent-prompts/code-simplifier.md",
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "shell",
    "code"
  ],
  "toolsSettings": {
    "read": {
      "deniedPaths": [
        "CLAUDE.md",
        ".claude/**"
      ]
    },
    "write": {
      "allowedPaths": [
        "cdk/**",
        "lambdas/**",
        "libs/**",
        "cli/**",
        "tests/**",
        "**/__tests__/**",
        "docs/**",
        "runbooks/**"
      ],
      "deniedPaths": [
        "openspec/specs/**",
        ".kiro/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "uv run ruff.*",
        "uv run pytest.*",
        "mise run cdk-test.*",
        "openspec .*",
        "git diff.*",
        "git log.*",
        "git status.*",
        "git show.*",
        "grep .*",
        "sed -n .*",
        "cat .*",
        "ls .*",
        "echo .*",
        "head .*",
        "tail .*",
        "wc .*",
        "which .*",
        "git --no-pager diff.*",
        "git --no-pager log.*",
        "git --no-pager status.*",
        "git --no-pager show.*",
        "git branch --show-current.*",
        "git check-ignore.*"
      ],
      "deniedCommands": [
        "git commit.*",
        "git add.*",
        "git push.*",
        "git reset.*",
        "git rebase.*",
        "git checkout.*",
        "git restore.*",
        "git clean.*",
        ".*mise run check.*",
        ".*mise run semgrep.*",
        "uv run ruff.*--unsafe-fixes.*",
        "rm -rf .*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://pyproject.toml"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "uv run ruff*",
          "uv run pytest*",
          "mise run cdk-test*",
          "openspec *",
          "git diff*",
          "git log*",
          "git status*",
          "git show*",
          "grep *",
          "sed -n *",
          "cat *",
          "ls *",
          "echo *",
          "head *",
          "tail *",
          "wc *",
          "which *",
          "git --no-pager diff*",
          "git --no-pager log*",
          "git --no-pager status*",
          "git --no-pager show*",
          "git branch --show-current*",
          "git check-ignore*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git add*",
          "git push*",
          "git reset*",
          "git rebase*",
          "git checkout*",
          "git restore*",
          "git clean*",
          "*mise run check*",
          "*mise run semgrep*",
          "uv run ruff*--unsafe-fixes*",
          "rm -rf *"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "CLAUDE.md",
          ".claude/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "cdk/**",
          "lambdas/**",
          "libs/**",
          "cli/**",
          "tests/**",
          "**/__tests__/**",
          "docs/**",
          "runbooks/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "openspec/specs/**",
          ".kiro/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:e4a5c6c31c2cc1131e770578076c678f74534c0da4b9dc005bd9f06ea302c726",
    "source": "sha256:fe59a23da0c54c9f2b7c2ce0b0e8998e99f13e850323c37fbd20392977b1e360"
  }
}
