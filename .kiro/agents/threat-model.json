{
  "$schema": "https://json.schemastore.org/kiro-agent.json",
  "name": "threat-model",
  "description": "STRIDE-analyze a draft OpenSpec change (proposal + design + spec deltas) as the propose-phase checkpoint \u2014 invoked between specs and tasks generation in `/openspec-propose` so findings shape Requirement amendments or task ordering BEFORE implementation begins. Triggers on \"threat model this change\", \"STRIDE analysis\", \"check trust boundaries for\", \"what could go wrong with this proposal\". Not for post-implementation review \u2014 the `security-reviewer` agent verifies that already-planned mitigations are in place at code-review time; introducing new threats after implementation is wasted work that should become a follow-up change.",
  "prompt": "file://../agent-prompts/threat-model.md",
  "tools": [
    "@threat-composer-ai/threat_modeling_get_tc_schema",
    "@threat-composer-ai/threat_modeling_validate_tc_schema",
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "write",
    "grep",
    "glob",
    "shell",
    "@threat-composer-ai/threat_modeling_get_tc_schema",
    "@threat-composer-ai/threat_modeling_validate_tc_schema"
  ],
  "toolsSettings": {
    "read": {
      "deniedPaths": [
        "CLAUDE.md",
        ".claude/**",
        "openspec/changes/archive/**"
      ]
    },
    "write": {
      "allowedPaths": [
        "openspec/changes/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "openspec .*",
        "python3 openspec/tools/.*",
        ".*uuidgen.*",
        "seq .*",
        "git diff.*",
        "git log.*",
        "git status.*",
        "git show.*"
      ],
      "deniedCommands": [
        "git commit.*",
        "git add.*",
        "git push.*",
        "git reset.*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    }
  },
  "mcpServers": {
    "threat-composer-ai": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/awslabs/threat-composer.git#subdirectory=packages/threat-composer-ai",
        "threat-composer-ai-mcp"
      ]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://README.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "openspec *",
          "python3 openspec/tools/*",
          "*uuidgen*",
          "seq *",
          "git diff*",
          "git log*",
          "git status*",
          "git show*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git add*",
          "git push*",
          "git reset*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "CLAUDE.md",
          ".claude/**",
          "openspec/changes/archive/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "openspec/changes/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "threat-composer-ai/threat_modeling_get_tc_schema",
          "threat-composer-ai/threat_modeling_validate_tc_schema"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:6a0e994bfc20f3973954d8f7e187702b7d421afb4630dabe1e9c8fe17646a6ca",
    "source": "sha256:39f07487d62d27965bcf0b4987473e9d37daa0e02aa84e5ebe7178281d8ac15e"
  }
}
