{
  "$schema": "https://json.schemastore.org/kiro-agent.json",
  "name": "tester",
  "description": "Use to write, run, or update tests for Cairn pipeline code (Lambdas, CDK, helpers). Triggers on \"write tests for\", \"test this\", \"stub out tests\", \"add a test for\", \"are there tests covering\", \"run the tests\", \"test coverage for\", or any request to verify behavior with automated tests before merging.",
  "tools": [
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "shell"
  ],
  "toolsSettings": {
    "read": {
      "deniedPaths": [
        "CLAUDE.md",
        ".claude/**",
        "openspec/changes/archive/**"
      ]
    },
    "write": {
      "allowedPaths": [
        "tests/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "deniedPaths": [
        "cdk/lib/**",
        "cdk/bin/**",
        "lambdas/*/cairn_lambda_*/**",
        "libs/*/cairn_*/**",
        "cli/cairn_cli/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "uv run pytest.*",
        "mise run cdk-test.*",
        "uv run ruff.*",
        "openspec list.*",
        "openspec status.*",
        "openspec instructions.*",
        "openspec validate.*",
        "git diff.*",
        "git log.*",
        "git status.*",
        "git show.*",
        "grep .*",
        "cat .*",
        "ls .*",
        "echo .*",
        "head .*",
        "tail .*",
        "wc .*",
        "which .*",
        "git --no-pager diff.*",
        "git --no-pager log.*",
        "git --no-pager status.*",
        "git --no-pager show.*",
        "git branch --show-current.*",
        "git check-ignore.*"
      ],
      "deniedCommands": [
        "git commit.*",
        "git add.*",
        "git push.*",
        "git reset.*",
        "git rebase.*",
        "git checkout.*",
        "git restore.*",
        "git clean.*",
        ".*mise run check.*",
        ".*mise run semgrep.*",
        "uv run ruff.*--unsafe-fixes.*",
        "rm -rf .*",
        ".*>\\s*openspec/.*",
        ".*>\\s*\\.kiro/.*",
        ".*tee .*openspec/.*",
        ".*tee .*\\.kiro/.*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": true
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://pyproject.toml"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "uv run pytest*",
          "mise run cdk-test*",
          "uv run ruff*",
          "openspec list*",
          "openspec status*",
          "openspec instructions*",
          "openspec validate*",
          "git diff*",
          "git log*",
          "git status*",
          "git show*",
          "grep *",
          "cat *",
          "ls *",
          "echo *",
          "head *",
          "tail *",
          "wc *",
          "which *",
          "git --no-pager diff*",
          "git --no-pager log*",
          "git --no-pager status*",
          "git --no-pager show*",
          "git branch --show-current*",
          "git check-ignore*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git add*",
          "git push*",
          "git reset*",
          "git rebase*",
          "git checkout*",
          "git restore*",
          "git clean*",
          "*mise run check*",
          "*mise run semgrep*",
          "uv run ruff*--unsafe-fixes*",
          "rm -rf *",
          "*> openspec/*",
          "*>openspec/*",
          "*> .kiro/*",
          "*>.kiro/*",
          "*tee *openspec/*",
          "*tee *.kiro/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "cat *",
          "echo *",
          "git --no-pager diff*",
          "git --no-pager log*",
          "git --no-pager show*",
          "git --no-pager status*",
          "git branch --show-current*",
          "git check-ignore*",
          "git diff*",
          "git log*",
          "git show*",
          "git status*",
          "grep *",
          "head *",
          "ls *",
          "mise run cdk-test*",
          "openspec instructions*",
          "openspec list*",
          "openspec status*",
          "openspec validate*",
          "tail *",
          "uv run pytest*",
          "uv run ruff*",
          "wc *",
          "which *"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "CLAUDE.md",
          ".claude/**",
          "openspec/changes/archive/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "tests/**",
          "**/__tests__/**",
          "**/*.test.*",
          "**/test_*.py",
          "**/*_test.py"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "cdk/lib/**",
          "cdk/bin/**",
          "lambdas/*/cairn_lambda_*/**",
          "libs/*/cairn_*/**",
          "cli/cairn_cli/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:4c9ec253a0ae1be741bfc04aa5084707e7121a0f6ef04d11c2fe53308a887bcc",
    "source": "sha256:fe7c9956da312bb39b63f077478d7f426bb83728ea265ce21c988218a47c54d6"
  }
}
